{
  "name": "@xfacts/featurefacts",
  "version": "0.2.2",
  "type": "module",
  "description": "FeatureFacts: a compact capability label and evidence-backed feature register.",
  "bin": {
    "featurefacts": "./bin/featurefacts.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs src/cli.ts",
    "prepack": "pnpm build",
    "featurefacts": "node bin/featurefacts.mjs",
    "test": "pnpm build && tsx --test tests/cli.test.ts tests/helm-repos.test.ts tests/product-title.test.ts tests/bin.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test",
    "preview": "node scripts/preview.mjs",
    "ship": "wrangler deploy --config site/wrangler.jsonc"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "minimatch": "^10.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.28.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.4",
      "fast-uri": "3.1.7"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "files": [
    "bin",
    "dist",
    "schemas",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catalyst-Forge-LLC/feature-facts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
